{
    "description": "Redirect Click'n'Load to remote pyload or jDownloader",
    "manifest_version": 3,
    "name": "Redirect Click'n'Load",
    "author": "Ronny Adams",    
    "options_ui": {
        "page": "options.html"
    },
    "action": {
        "default_icon": {
            "128": "images/icon.png"
        },
        "default_title": "Click'n'Load Request Proxy"
    },
    "icons": {
        "128": "images/icon.png"
    },

    "host_permissions": ["<all_urls>"],
    "permissions": [
        "declarativeNetRequest",
        "webRequest",
        "webNavigation",
        "storage",
        "activeTab",
        "scripting"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "version": "1.5.0",
    "web_accessible_resources": [
        {
            "resources": [ "jdcheck.js" ],
            "matches": ["<all_urls>"]
        }
    ]
}